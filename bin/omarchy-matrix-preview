#!/bin/bash

# Maintains the still image that stands in for the matrix rain in Omarchy's
# background picker.
#
# omarchy-menu-images can only list still images, so the rain is represented by
# a preview PNG. nzkritik.matrix-rain recognises that file by name and draws
# the live effect instead of the still. The file is written into the *current
# theme's* user background folder, a directory the stock picker already scans —
# which is why none of this needs to override any packaged command.
#
# The preview is a grayscale capture of the real rain, recoloured here to the
# theme's accent so the entry matches whatever theme is active. The plugin runs
# it on every theme change; it is idempotent and cheap to call repeatedly.
#
#   (no arguments)   ensure the preview exists and matches the theme
#   --print-path     the same, then print the path (used to select the rain)
#   --all            ensure a preview exists for EVERY installed theme
#   --capture        rebuild the grayscale master from the running rain
#
# Requires: ImageMagick. --capture additionally needs grim, jq and hyprctl.

set -euo pipefail

# Must match rainFile in Service.qml.
RAIN_FILE="zz-matrix-rain.png"

SELF=$(readlink -f "$0")
PLUGIN_DIR=${SELF%/bin/*}
MASTER="$PLUGIN_DIR/assets/matrix-master.png"

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy-matrix-rain"
THEME_NAME_FILE="$HOME/.local/state/omarchy/current/theme.name"
THEME_COLORS="$HOME/.local/state/omarchy/current/theme/colors.toml"

fail() {
  echo "omarchy-matrix-preview: $*" >&2
  exit 1
}

# --- untrusted-path discipline -----------------------------------------------
#
# Every path below is predictable and writable by anything running as this user,
# so whatever is sitting at one is untrusted input -- on the way in and on the
# way out.

# iflag=nofollow refuses a symlink rather than following it somewhere else,
# nonblock means a planted FIFO returns immediately instead of wedging this
# process, and count bounds how much a swollen replacement can hand back. The
# read is best-effort by design -- a caller that gets nothing reports its own
# error rather than inheriting dd's.
read_guarded() { # <path> <block-size> <blocks>
  dd if="$1" iflag=nofollow,nonblock bs="$2" count="$3" 2>/dev/null || true
}

# A directory we are about to write into must be a real directory, reached
# without traversing a symlink at the final component.
require_real_dir() {
  [[ -L $1 ]] && fail "refusing to use $1: it is a symlink"
  [[ -d $1 ]] || fail "not a directory: $1"
  return 0
}

# A file we are about to replace must be absent, or a plain regular file that
# is not a symlink. A link at the target would redirect the write into another
# of the user's files; a FIFO or device would block or swallow it.
require_plain_target() {
  [[ -L $1 ]] && fail "refusing to write $1: it is a symlink"
  [[ -e $1 && ! -f $1 ]] && fail "refusing to write $1: not a regular file"
  return 0
}

# Stage a temp file beside the destination -- same directory, so the commit is
# a rename within one filesystem and cannot fall back to a copy. Created 0600
# by mktemp and relaxed only once, so no partial file is ever world-readable
# under a name anything else is looking for.
stage_tmp() { # <dest> -> prints tmp path
  local dir tmp
  dir=${1%/*}
  require_real_dir "$dir"
  require_plain_target "$1"
  tmp=$(mktemp "$dir/.omarchy-matrix-preview.XXXXXX") || fail "could not stage a write in $dir"
  printf '%s' "$tmp"
}

# Flush, recheck the target, then rename. The recheck narrows the window in
# which the destination could be swapped for a link between staging and commit;
# bash cannot hold a directory descriptor across the rename, so this is a bound
# on the race rather than the elimination of it. The rename itself does not
# follow a symlink at the destination, so the worst case is a refusal.
commit_tmp() { # <tmp> <dest>
  chmod 0644 "$1"
  sync "$1" 2>/dev/null || sync
  require_plain_target "$2"
  mv -f "$1" "$2" || { rm -f "$1"; fail "could not install $2"; }
}

discard_tmp() { rm -f "$1" 2>/dev/null || true; }

# -----------------------------------------------------------------------------

mode=ensure
case "${1:-}" in
  "") ;;
  --print-path) mode=print ;;
  --all) mode=all ;;
  --capture) mode=capture; force_render=1 ;;
  -h | --help)
    sed -n '3,21p' "$SELF" | sed 's/^# \{0,1\}//'
    exit 0
    ;;
  *)
    echo "omarchy-matrix-preview: unknown option: $1" >&2
    exit 1
    ;;
esac

# The name becomes a path component, so it is checked rather than trusted: a
# leading dot is refused, which rules out "..", a slash is not in the set, and
# the length cap keeps a padded name from reaching mkdir as a 255-byte one.
valid_theme_name() { [[ $1 =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$ ]]; }

# A theme with no readable accent still gets an entry, in the neutral grey the
# renderer falls back to, rather than being left out of the picker entirely.
read_accent() { # <colors.toml>
  local a
  a=$(read_guarded "$1" 4096 16 |
    sed -n 's/^[[:space:]]*accent[[:space:]]*=[[:space:]]*"\{0,1\}#\{0,1\}\([0-9a-fA-F]\{6\}\)"\{0,1\}.*/\1/p' |
    head -n1)
  [[ $a =~ ^[0-9a-fA-F]{6}$ ]] || a="cacccc"
  printf '%s' "$a"
}

# Renders one theme's preview, or does nothing when the one on disk already
# matches. Skipping matters: rewriting bumps the mtime and throws away the
# picker's cached thumbnail for no reason. -f and -nt both follow links, so the
# no-symlink test comes first -- otherwise a link planted at the destination
# could make this look fresh and skip a write that would have refused.
render_theme() { # <theme> <accent> [force]
  local theme=$1 accent=$2 force=${3:-}
  local out_dir="$HOME/.config/omarchy/backgrounds/$theme"
  local out="$out_dir/$RAIN_FILE"
  # Kept out of the background folder so the picker never sees a stray file.
  local stamp="$STATE_DIR/$theme.accent"
  local stamped out_tmp stamp_tmp

  stamped=$(read_guarded "$stamp" 1 64 | head -n1)
  if [[ -z $force && ! -L $out && -f $out && ! -L $stamp && -f $stamp &&
    $out -nt $MASTER && $stamped == "$accent" ]]; then
    return 0
  fi

  mkdir -p "$out_dir" "$STATE_DIR"
  require_real_dir "$out_dir"
  require_real_dir "$STATE_DIR"

  # The master is a luminance ramp over black, which is exactly the shape
  # +level-colors wants: black stays black, white becomes the accent, and the
  # tails in between land on the same gradient the renderer draws.
  out_tmp=$(stage_tmp "$out")
  if ! magick "$MASTER" +level-colors "black,#$accent" -colorspace sRGB PNG24:"$out_tmp"; then
    discard_tmp "$out_tmp"
    fail "could not render the preview for $theme"
  fi
  commit_tmp "$out_tmp" "$out"

  # Written only after the preview it describes is in place, so an interrupted
  # run leaves the stamp stale rather than claiming work that did not happen.
  stamp_tmp=$(stage_tmp "$stamp")
  printf '%s' "$accent" >"$stamp_tmp" || { discard_tmp "$stamp_tmp"; fail "could not record the accent"; }
  commit_tmp "$stamp_tmp" "$stamp"
}

require_master() {
  [[ -f $MASTER && ! -L $MASTER && -r $MASTER ]] ||
    fail "missing or unusable master image: $MASTER"
}

# --all: seed every installed theme, so the rain is in the picker the first time
# a theme is opened rather than about a second later.
#
# The picker enumerates ~/.config/omarchy/backgrounds/<theme> live each time it
# opens, so an entry that is not on disk yet is simply absent from the list --
# with no error and nothing to retry. Writing the preview only for the theme in
# use loses that race on a theme's first visit, which is precisely when a user
# goes looking for a new background.
#
# A user theme shadows a stock one of the same name, so it is taken first and
# the stock copy skipped. One bad theme must not cost the rest, so each render
# runs in a subshell: fail() there ends that theme, not the sweep.
if [[ $mode == all ]]; then
  require_master
  seen=" "
  for dir in "$HOME/.config/omarchy/themes"/*/ "${OMARCHY_PATH:-/usr/share/omarchy}/themes"/*/; do
    [[ -d $dir ]] || continue
    name=${dir%/}
    name=${name##*/}
    valid_theme_name "$name" || continue
    [[ $seen == *" $name "* ]] && continue
    seen+="$name "
    (render_theme "$name" "$(read_accent "$dir/colors.toml")") ||
      echo "omarchy-matrix-preview: skipped $name" >&2
  done
  exit 0
fi

theme=$(read_guarded "$THEME_NAME_FILE" 1 256 | head -n1)
[[ -n $theme ]] || fail "no current theme ($THEME_NAME_FILE)"
valid_theme_name "$theme" || fail "refusing implausible theme name ($THEME_NAME_FILE)"

OUT_DIR="$HOME/.config/omarchy/backgrounds/$theme"
OUT="$OUT_DIR/$RAIN_FILE"

if [[ $mode == capture ]]; then
  # grim captures whatever is composited, so a window anywhere on the active
  # workspace would be baked into the wallpaper preview.
  if [[ $(hyprctl activeworkspace -j | jq -r '.windows') != "0" ]]; then
    fail "the active workspace has windows on it; clear the screen or switch to an empty workspace first"
  fi
  if [[ $(readlink -f "$HOME/.local/state/omarchy/current/background" 2>/dev/null) != "$OUT" ]]; then
    fail "select the matrix rain first (omarchy-shell matrix-rain select)"
  fi

  shot=$(mktemp --suffix=.png)
  trap 'rm -f "$shot"' EXIT
  grim "$shot"

  # Rain is stochastic, so a fixed crop can land on a bare patch. Score a few
  # candidate tiles by mean luminance -- which for glyphs on black is just
  # density -- and keep the busiest. Tiles are a 16:9 third of the screen, and
  # the top row is skipped so the bar never lands in the preview.
  w=$(identify -format '%w' "$shot")
  h=$(identify -format '%h' "$shot")
  cw=$((w / 3))
  ch=$((cw * 9 / 16))

  best_geom=""
  best_score=-1
  for x in 0 $(((w - cw) / 2)) $((w - cw)); do
    for y in $((h / 16)) $(((h - ch) / 2)) $((h - ch)); do
      geom="${cw}x${ch}+${x}+${y}"
      score=$(magick "$shot" -crop "$geom" +repage -colorspace Gray \
        -format '%[fx:int(mean*100000)]' info:)
      if ((score > best_score)); then
        best_score=$score
        best_geom=$geom
      fi
    done
  done

  # -auto-level pulls the head glyphs back up to white; without it the tint
  # below maps the brightest pixel to well short of the accent and the preview
  # reads as a muddy version of the theme colour. Upscaled so the glyphs
  # survive being thumbnailed by the picker, and desaturated because the tint
  # supplies the colour.
  #
  # Staged and renamed like every other write here: this one lands inside the
  # plugin's own directory, but that is under $HOME and no more trustworthy for
  # it. An explicit PNG: prefix because the temp name has no extension.
  master_tmp=$(stage_tmp "$MASTER")
  if ! magick "$shot" -crop "$best_geom" +repage \
    -colorspace Gray -auto-level -filter Lanczos -resize '1920x1080!' PNG:"$master_tmp"; then
    discard_tmp "$master_tmp"
    fail "could not rebuild the master image"
  fi
  commit_tmp "$master_tmp" "$MASTER"
fi

require_master

accent=$(read_accent "$THEME_COLORS")
render_theme "$theme" "$accent" "${force_render:-}"

[[ $mode == print ]] && printf '%s\n' "$OUT"
exit 0
